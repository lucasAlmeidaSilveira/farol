# Configuração do Firebase Web.
#
# NADA aqui é segredo. A `apiKey` do Firebase Web não é uma credencial — é um
# identificador de roteamento e não autoriza nada. Quem defende os dados é o
# Auth (quem você é) somado às Security Rules (o que você pode). Não perca tempo
# tentando esconder estes valores: eles vão para o bundle do navegador por
# design, e é assim que o Firebase funciona.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=farol-app-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=farol-app-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=farol-app-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Desenvolvimento roda contra o projeto `farol-app-dev` na nuvem, não contra
# emulador — por isso `false`. A separação entre os dois projetos Firebase é o
# que mantém dado de teste longe de dado real, e ela não depende desta flag.
#
# Os testes de rules são a única exceção, e não pedem nada de você: o
# `pnpm test:rules` sobe e derruba um emulador efêmero sozinho, porque
# `@firebase/rules-unit-testing` não roda contra um projeto de verdade.
NEXT_PUBLIC_USE_EMULATORS=false

# Apple Sign In só na Fase 2: exige domínio público verificado, o que é
# impossível antes de o app estar publicado. O código já está pronto.
NEXT_PUBLIC_APPLE_ENABLED=false

# ---------------------------------------------------------------------------
# SEGREDOS DE SERVIDOR — nenhum no MVP.
#
# Quando existirem (chave do Admin SDK, .p8 da Apple, token de terceiro),
# JAMAIS use o prefixo NEXT_PUBLIC_. O Next inlina o valor no bundle de
# QUALQUER arquivo que referencie a variável, e uma chave de service account
# publicada assim está comprometida de forma permanente — inclusive em todo
# build já publicado.
# ---------------------------------------------------------------------------
