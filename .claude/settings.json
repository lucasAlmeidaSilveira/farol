{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm palette*)",
      "Bash(pnpm icons*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm exec next*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Bash(pnpm rules:deploy:prod*)",
      "Bash(firebase deploy*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(npx shadcn*)",
      "Bash(pnpm dlx shadcn*)",
      "Bash(pnpm exec shadcn*)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formatando e ordenando imports...",
            "timeout": 60,
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; cd \"${CLAUDE_PROJECT_DIR:-.}\"; case \"$f\" in *.ts|*.tsx|*.mts|*.mjs|*.css|*.json|*.md) pnpm exec prettier --write \"$f\";; esac; case \"$f\" in *.ts|*.tsx|*.mts|*.mjs) pnpm exec eslint --fix \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
